# Copy to .env and fill in. .env is git ignored; never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma separated. Leave empty in development to allow any browser origin,
# which the Expo web build needs. Must be set explicitly in production.
CORS_ORIGINS=

# Neon: Dashboard -> Connect -> keep "Connection pooling" on and copy the
# string. The pooled host is the one containing "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false

# Generate each one separately: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_PASSWORD_RESET_SECRET=
JWT_PASSWORD_RESET_TTL=10m

# Absolute session lifetime. The shorter one applies when the user did not tick
# "keep me signed in"; rotation never extends either.
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SESSION_TTL_DAYS=1

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5

MAIL_FROM=Instant Connect <no-reply@instantconnect.app>

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
