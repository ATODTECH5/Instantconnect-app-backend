
NODE_ENV=development
PORT=5001
LOG_LEVEL=debug


CORS_ORIGINS=


DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_PASSWORD_RESET_SECRET=
JWT_PASSWORD_RESET_TTL=10m


REFRESH_TOKEN_SESSION_TTL_DAYS=1


ADMIN_COOKIE_DOMAIN=

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5


RESEND_API_KEY=


MAIL_FROM=Instant Connect <onboarding@resend.dev>


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=instant-connect/profiles
CLOUDINARY_CHAT_FOLDER=instant-connect/chat
CLOUDINARY_KYC_FOLDER=instant-connect/kyc
CLOUDINARY_EVENTS_FOLDER=instant-connect/events


EXPO_ACCESS_TOKEN=
EVENTBRITE_TOKEN=

PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=instantconnectclient://profile/subscription/complete
PUBLIC_API_URL=

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120


SWAGGER_ENABLED=true

# Oldest app version allowed to run (e.g. 1.2.0). Older apps are told to
# update. Leave empty to let every version through. Store links are where
# the update screen sends people; fill them once the listings exist.
MIN_APP_VERSION=
APP_STORE_URL=
PLAY_STORE_URL=
