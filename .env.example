# Copy to .env and fill in. .env is git ignored; never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma separated. Leave empty in development to allow any browser origin,
# which the Expo web build needs. Must be set explicitly in production.
CORS_ORIGINS=

# Neon: Dashboard -> Connect -> keep "Connection pooling" on and copy the
# string. The pooled host is the one containing "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false

# Generate each one separately: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_PASSWORD_RESET_SECRET=
JWT_PASSWORD_RESET_TTL=10m

# Absolute session lifetime. The shorter one applies when the user did not tick
# "keep me signed in"; rotation never extends either.
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SESSION_TTL_DAYS=1

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5

# Resend API key. Leave it unset and verification codes are written to the log
# instead of sent, which is the default for local work. Set it and real email
# goes out. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on a domain verified with Resend. The shared
# onboarding@resend.dev sender needs no domain, but Resend will only deliver it
# to the address that owns the Resend account, which is enough for testing your
# own sign ups. Switch this to no-reply@instantconnect.app once the domain is
# verified.
MAIL_FROM=Instant Connect <onboarding@resend.dev>

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Serves the OpenAPI docs at /docs and the raw document at /docs/json.
# A kill switch rather than an environment gate: the docs are public.
SWAGGER_ENABLED=true
